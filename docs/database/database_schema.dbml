Table customer {
  id int [primary key]
  name varchar [not null]
  phone varchar [not null]
  created_at timestamptz [not null]
}

Table court {
  id int [primary key]
  name varchar [not null, unique]
  floor_type floor_type [not null]
  available boolean [not null]
  price_per_hour decimal(10,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table reservation {
  Note: "A court cannot have two active reservations with overlapping time intervals. The relevant columns are status, start_time, end_time, and court_id. Cancelled reservations are excluded from this rule. The end of the interval is exclusive, so consecutive reservations do not conflict. The database guarantees that overlapping reservations cannot exist, and the service must also handle this error and display a user-friendly message. There is a constraint requiring end_time to be greater than start_time, ensuring that a reservation has a valid, positive duration."
  id int [primary key]
  court_id int [not null]
  customer_id int [not null]
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  status reservation_status [not null]
  total_price decimal(10,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (court_id, start_time, end_time)
  }

  checks {
    `end_time > start_time`
  }
}

Table sport {
  id int [primary key]
  name varchar [not null, unique]
}

Table court_sport {
  court_id int [not null]
  sport_id int [not null]

  indexes {
    (court_id, sport_id) [pk]
  }
}

Table operating_hours {
  Note: "The operating hours are the same for all courts, so the table stores a single row with a fixed ID. For this reason, the constraint enforces id = 1. This constraint is enforced by the database itself. There is a constraint requiring closing_time to be later than opening_time, since operating hours do not span midnight."
  id int [primary key]
  opening_time time [not null]
  closing_time time [not null]
  updated_at timestamptz [not null]

  checks {
    `id = 1`
    `closing_time > opening_time`
  }
}

enum floor_type {
  sand
  synthetic_turf
  hardwood
  epoxy
}

enum reservation_status {
  confirmed
  cancelled
  no_show
  completed
}

Ref: court.id < reservation.court_id
Ref: customer.id < reservation.customer_id
Ref: court_sport.court_id > court.id
Ref: court_sport.sport_id > sport.id